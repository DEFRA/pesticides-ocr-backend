# Local environment variables for development.
#
# Copy this file to `.env` (`cp .env.example .env`) before running the app
# locally. The file can be left empty — it only needs to exist, because the
# dev script runs `node --watch --env-file-if-exists=.env` and `--watch`
# fails with ENOENT if the .env file is missing.
#
# Uncomment and adjust any of the values below to override the defaults in
# src/config.js for your local environment.

# PORT=3001
# REFERENCE_PREFIX=OCR
# MONGO_URI=mongodb://127.0.0.1:27017/
# NOTIFY_KEY_MODE=test            # `team` sends real email to the guestlist, `test` sends none
# NOTIFY_TEAM_API_KEY=
# NOTIFY_TEST_API_KEY=
# NOTIFY_TEMPLATE_SUBMISSION_CONFIRMATION=
# Template body must reference the code as ((otp)). Defaults to the ID below.
# NOTIFY_TEMPLATE_EMAIL_VERIFICATION_OTP=ca8b5958-4ba0-4806-9e84-1143dfc3e841

# --- Email address verification (OTP) --------------------------------------
# EMAIL_OTP_HASH_SECRET=            # required at runtime; HMAC key for hashing codes/tokens at rest
# EMAIL_OTP_LENGTH=6                # 4 or 6
# EMAIL_OTP_TTL_SECONDS=300
# EMAIL_OTP_MAX_ATTEMPTS=5
# EMAIL_OTP_MAX_RESENDS=5
# EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
# EMAIL_OTP_RECORD_TTL_SECONDS=86400
# EMAIL_OTP_RATE_LIMIT_EMAIL_PER_HOUR=5
# EMAIL_OTP_RATE_LIMIT_IP_PER_HOUR=20

# --- API authorisation (EQ-413) --------------------------------------------
# Auth mode is chosen by the CDP tier: `mock` on local only (bearer tokens are
# decoded, NOT verified), `live` on every deployed tier (ENVIRONMENT != local).
# Set the ENTRA_* values so live mode can verify real Entra tokens via JWKS.
# AUTH_MODE=live
# ENTRA_TENANT_ID=              # tenant (directory) id; issuer + JWKS derived from it
# ENTRA_API_AUDIENCE=          # expected token audience (API app-registration id) — required in live mode
# ENTRA_ISSUER=                # override the derived v2.0 issuer (optional)
# ENTRA_JWKS_URI=              # override the derived JWKS endpoint (optional)
# ENTRA_CASE_OFFICER_ROLE_VALUES=case_officer          # app-role value(s) that grant access
# ENTRA_CASE_OFFICER_ROLE_VALUES=case_officer,admin    # comma-separated for multiple roles
# ENTRA_REQUIRED_SCOPE=access_as_user                  # require this SHORT scope in the token's scp claim; empty = not enforced (EQ-442)

# --- Journey metrics beacon (EQ-472) ---------------------------------------
# HMAC secret for verifying signed journey-tracking beacon tokens. Must match the
# frontend's JOURNEY_TOKEN_SECRET for the tier. Empty = verification disabled
# (deployed tiers warn at boot). Set via CDP Secrets on deployed tiers.
# JOURNEY_TOKEN_SECRET=
