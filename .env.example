# Local environment variables for development.
#
# Copy this file to `.env` (`cp .env.example .env`) before running the app
# locally. The file can be left empty — it only needs to exist, because the
# dev script runs `node --watch --env-file-if-exists=.env` and `--watch`
# fails with ENOENT if the .env file is missing.
#
# Uncomment and adjust any of the values below to override the defaults in
# src/config.js for your local environment.

# PORT=3001
# REFERENCE_PREFIX=OCR
# EXPORT_MAX_ROWS=10000
# SEARCH_MAX_PAGE_SIZE=100
# MONGO_URI=mongodb://127.0.0.1:27017/?directConnection=true
# NOTIFY_TEAM_API_KEY=
# NOTIFY_TEST_API_KEY=
# NOTIFY_TEMPLATE_SUBMISSION_CONFIRMATION=
# NOTIFY_TEMPLATE_EMAIL_VERIFICATION_LINK=

# --- Email verification (magic link) ---------------------------------------
# Requests are refused (503) until JOURNEY_TOKEN_SECRET, the hash secret, the
# link base URL, a Notify key and the template ID are all set. Deployed tiers
# warn at boot for each one that is missing. The base URL is the frontend's
# origin (no path or trailing slash) and must be https outside the local tier.
# The retention must be at least the link TTL plus the verified TTL.
# EMAIL_VERIFICATION_LINK_BASE_URL=            # e.g. http://localhost:3000 locally
# EMAIL_VERIFICATION_HASH_SECRET=              # any random string locally; CDP Secrets on deployed tiers
# EMAIL_VERIFICATION_LINK_TTL_SECONDS=900
# EMAIL_VERIFICATION_VERIFIED_TTL_SECONDS=14400
# EMAIL_VERIFICATION_RECORD_RETENTION_SECONDS=86400
# EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# EMAIL_VERIFICATION_MAX_SENDS_PER_EMAIL_PER_HOUR=5
# EMAIL_VERIFICATION_MAX_SENDS_PER_JOURNEY_PER_HOUR=5
# EMAIL_VERIFICATION_MAX_SENDS_GLOBAL_PER_HOUR=1000
# POST /register needs x-journey-token and a contact email verified for that
# journey. Defaults to false until the tier's frontend sends the journey token
# to /register; turn on per tier once it does. Deployed tiers warn at boot
# while it's off.
# EMAIL_VERIFICATION_REQUIRED_FOR_REGISTRATION=false

# --- API authorisation (EQ-413) --------------------------------------------
# Auth mode is chosen by the CDP tier: `mock` on local only (bearer tokens are
# decoded, NOT verified), `live` on every deployed tier (ENVIRONMENT != local).
# Set the ENTRA_* values so live mode can verify real Entra tokens via JWKS.
# AUTH_MODE=live
# ENTRA_TENANT_ID=              # tenant (directory) id; issuer + JWKS derived from it
# ENTRA_API_AUDIENCE=          # expected token audience (API app-registration id) — required in live mode
# ENTRA_ISSUER=                # override the derived v2.0 issuer (optional)
# ENTRA_JWKS_URI=              # override the derived JWKS endpoint (optional)
# ENTRA_CASE_OFFICER_ROLE_VALUES=case_officer          # app-role value(s) that grant access
# ENTRA_CASE_OFFICER_ROLE_VALUES=case_officer,admin    # comma-separated for multiple roles
# ENTRA_REQUIRED_SCOPE=access_as_user                  # require this SHORT scope in the token's scp claim; empty = not enforced (EQ-442)

# --- Journey metrics beacon (EQ-472) ---------------------------------------
# HMAC secret for verifying signed journey-tracking beacon tokens. Must match the
# frontend's JOURNEY_TOKEN_SECRET for the tier. Empty = verification disabled
# (deployed tiers warn at boot), and email verification refuses every request.
# Set via CDP Secrets on deployed tiers.
JOURNEY_TOKEN_SECRET=local-dev-only-journey-token-secret
